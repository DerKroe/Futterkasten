<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Futterkasten_NET_10.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Futterkasten"
    xmlns:vm="clr-namespace:Futterkasten.ViewModel"
    Shell.FlyoutBehavior="Flyout">

    <Shell.BindingContext>
        <vm:MainPageViewModel/>
    </Shell.BindingContext>
    
    <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage"/>
    <ShellContent Title="Essen" ContentTemplate="{DataTemplate local:EssenslisteBearbeiten}" Route="EssenslisteBearbeiten"/>
    <ShellContent Title="Google Link" ContentTemplate="{DataTemplate local:GoogleLink}" Route="GoogleLink"/>
</Shell>
